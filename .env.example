# ---------------------------------------------------------------------------
# Copy to .env for local work, and add the same keys in Vercel:
#   vercel env add SUPABASE_URL production     (and preview / development)
# Never commit the real .env - the service key bypasses every access rule.
# ---------------------------------------------------------------------------

# Supabase -> Project settings -> Data API / API keys
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...          # service_role key, server only

# Session cookie + code hashing. Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
LOGIN_PEPPER=

# Public URL of the deployment, used in the sign-up link
APP_URL=https://your-app.vercel.app

# Dates and timetables are calculated in this timezone
APP_TIMEZONE=Asia/Colombo

# Login codes. 4 matches the prototype; 6 is the sensible production value.
CODE_LENGTH=4
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15
JOIN_MAX_PER_HOUR=5

# Show the demo codes on the login screen. Leave unset in production.
DEMO_HINT=0

# Protects /api/cron. Vercel sends it as `Authorization: Bearer <value>`.
CRON_SECRET=

# WhatsApp Business Cloud API (optional).
# Without these the app still works: it opens WhatsApp with the message ready
# for the teacher to send, and records the event either way.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v21.0

# The Plus team's onboarding wizard at /onboard?k=<key>. It creates teacher
# accounts, so the page answers 404 unless this is set and matches exactly.
# Leave it unset to switch the tool off entirely.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ONBOARD_KEY=
ONBOARD_MAX_PER_HOUR=20
