{
  "name": "plus-teacher-app",
  "version": "1.0.0",
  "private": true,
  "description": "Timetable, attendance, fees and parent updates for private tuition teachers.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vercel dev",
    "test": "node --test tests/*.test.js",
    "check:db": "node --env-file=.env scripts/db-check.mjs",
    "check:live": "node --env-file=.env scripts/live-check.mjs",
    "check:clean": "node --env-file=.env scripts/check-clean.mjs",
    "db:push": "node --env-file=.env scripts/db-push.mjs",
    "db:verify": "node --env-file=.env scripts/db-verify.mjs",
    "seed": "node --env-file=.env scripts/seed.mjs",
    "seed:fresh": "node --env-file=.env scripts/seed.mjs --fresh",
    "set-code": "node --env-file=.env scripts/set-code.mjs",
    "deploy": "vercel --prod"
  }
}
